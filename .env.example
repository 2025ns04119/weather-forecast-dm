# Copy this file to .env and fill in your own values (.env is never committed)
# Neon (cloud PostgreSQL): Neon console -> project -> Connect
NEON_DB_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
# DagsHub (MLflow tracking + model registry, DVC remote)
MLFLOW_TRACKING_URI=https://dagshub.com/2025ns04119/weather-forecast-dm.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>
# Prefect Cloud (optional on a laptop - GitHub Actions uses repository secrets)
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=<your-prefect-api-key>
# Monitored city
LAT=12.97
LON=77.59
LOCATION=Bengaluru
